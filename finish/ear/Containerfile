FROM icr.io/appcafe/open-liberty:full-java11-openj9-ubi

# Copy server config from source tree.
# NOTE: In container dev mode libertyCreate() only creates the directory
# skeleton, so build/wlp/ files are NOT available at image-build time.
# Always copy server.xml from src/main/liberty/config/.
COPY --chown=1001:0 src/main/liberty/config/server.xml /config/
COPY --chown=1001:0 src/main/liberty/config/server.env /config/

# Copy the EAR archive.
# In loose-application mode dev mode will also mount a .ear.xml loose config
# file alongside this so Liberty picks up live class changes without restart.
COPY --chown=1001:0 build/libs/guide-gradle-multimodules-ear-1.0-SNAPSHOT.ear /config/apps/

USER 1001
